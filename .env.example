# ==============================================================================
# KAI Wellness Retreats - Comprehensive Environment Configuration
# Curated by Kareena Islam, BSN, RN | Grand Travel & Cruise Host Agency Legacy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Public site canonical base URL (used for sitemaps, metadataBase, canonical links)
NEXT_PUBLIC_SITE_URL="https://kaiwellnessretreats.com"

FASTAPI_BACKEND_URL="http://127.0.0.1:8972"

# Public API URL for client-side fetches (if not proxying through /api)
# Leave unset so the browser calls same-origin /api/v1 through proxy.ts (required for portal auth).
# NEXT_PUBLIC_FASTAPI_BACKEND_URL=""

# Node Environment
NODE_ENV="production"


# ------------------------------------------------------------------------------
# 2. FastAPI Backend & Database Core
# ------------------------------------------------------------------------------
# Primary database connection string (SQLite default; PostgreSQL supported).
# Leave commented for Docker: compose stores SQLite on the kai_data volume.
# Production: use the Neon *pooled* connection string, e.g.
#   DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/kai?sslmode=require"
# DATABASE_URL="sqlite:///./kai_sanctuary.db"

# API Route Prefix
API_V1_PREFIX="/api/v1"

# "production" enforces webhook signatures and refuses to boot with empty/default secrets.
ENVIRONMENT="production"

# Founder portal + admin API credentials (shared by the Next.js portal gate and FastAPI).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Secret hidden endpoint for staff portal access (never linked on public site)
HIDDEN_PORTAL_ENDPOINT="/staff-sanctuary-gate"

# Signing key for JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""

# Shared secret expected in X-Email-Webhook-Secret on inbound email ingestion
EMAIL_WEBHOOK_SECRET=""


# ------------------------------------------------------------------------------
# 3. Founder & Clinical Concierge Routing
# ------------------------------------------------------------------------------
# Destination inbox for incoming guest reservation intake forms & questions
KAREENA_ROUTING_EMAIL="kareena@kaiwellnessretreats.com"
ARMAAN_ROUTING_EMAIL="armaan@kaiwellnessretreats.com"

# Mobile phone number for Kareena's WhatsApp & SMS operational dispatch
OPERATOR_NOTIFICATION_PHONE="+17135550199"

# Transactional Email Delivery (Resend API - https://resend.com)
# When omitted or when ENABLE_LIVE_EMAIL_DISPATCH="false", all outgoing emails
# are staged in the Action Review Queue and logged as simulated dispatches.
RESEND_API_KEY=""

# Verified sender email addresses in your Resend domain (e.g. resend.com/domains)
RESEND_FROM_EMAIL="KAI Sanctuary Reservations <inquiries@kaiwellnessretreats.com>"
RESEND_CONCIERGE_FROM_EMAIL="KAI Concierge Desk <concierge@kaiwellnessretreats.com>"

# Inbound webhook secret for Resend delivery event verification (optional)
RESEND_WEBHOOK_SECRET=""


# ------------------------------------------------------------------------------
# 4. Host Agency & Grand Travel Flight Desk Metadata
# ------------------------------------------------------------------------------
HOST_AGENCY_NAME="Grand Travel & Cruise"
HOST_AGENCY_LEGACY_YEARS="25"
HOST_AGENCY_STATUS="Funjet 500 Club Member / ASTA Accredited"
FOUNDER_TRAVEL_RECOGNITION="Future Leaders in Travel Honoree"
FLIGHT_CONCIERGE_EMAIL="concierge@kaiwellnessretreats.com"


# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------






# ------------------------------------------------------------------------------
# 6. WhatsApp Cloud API & Mobile Dispatch (Meta Graph API)
# ------------------------------------------------------------------------------
# Messaging provider: "cloud_api" (Meta WhatsApp Cloud) or "twilio" or "simulator"
WHATSAPP_PROVIDER="cloud_api"

# Meta WhatsApp Cloud API System User Access Token
WHATSAPP_CLOUD_API_KEY=""

# Meta WhatsApp Phone Number ID (from Meta Developer App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=""

# Meta WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Verification token configured in Meta App Dashboard for webhook verification challenge
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""


# ------------------------------------------------------------------------------
# 7. Twilio SMS Fallback (Optional)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE="+18005550199"


# ------------------------------------------------------------------------------
# 8. Dynamic Mapping & Official Road Routing (OSRM / OpenRouteService / Mapbox / Google)
# ------------------------------------------------------------------------------
# Routing provider: "osrm" (default, free, no API key needed), "openrouteservice", "mapbox", or "google"
MAP_PROVIDER="osrm"

# OpenRouteService API Key (optional, from https://openrouteservice.org)
OPENROUTESERVICE_API_KEY=""

# Mapbox Access Token (optional, for Mapbox Directions & vector tiles)
MAPBOX_ACCESS_TOKEN=""

# Google Maps API Key (optional, for Google Routes & Places)
GOOGLE_MAPS_API_KEY=""


# ------------------------------------------------------------------------------
# 9. Groq LLM & Whisper Speech-to-Text (free tier: https://console.groq.com/keys)
# ------------------------------------------------------------------------------
# Powers the copilot, inquiry parsing and voice-note transcription. Without it, AI features
# return explicit errors (clinical screening and rule-based parsing still run).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"


# ------------------------------------------------------------------------------
# 10. Live Communications & Production Delivery Toggles
# ------------------------------------------------------------------------------
# Default is "false" (safe simulation mode: all emails/messages logged locally).
# Set to "true" once live provider credentials above are populated.

# Enable live email dispatch via Resend API (requires RESEND_API_KEY)
ENABLE_LIVE_EMAIL_DISPATCH="false"

# Enable live WhatsApp dispatch via Meta Cloud API (requires WHATSAPP_CLOUD_API_KEY & PHONE_ID)
ENABLE_LIVE_WHATSAPP_DISPATCH="false"

ENABLE_LIVE_CRM_SYNC="false"


# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Cirium FlightStats & Expedia webhook verification secrets
CIRIUM_WEBHOOK_SECRET=""
EXPEDIA_WEBHOOK_SECRET=""


# Host ports
BACKEND_PORT=8972
FRONTEND_PORT=3536
