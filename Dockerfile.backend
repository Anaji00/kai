# =============================================================================
# KAI Wellness Retreats - Backend Sidecar Service (FastAPI & Clinical RAG)
# =============================================================================
FROM python:3.11-slim AS runner

WORKDIR /app

# Install system dependencies (curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY backend/ ./backend/

# Create non-root system user and a writable data directory for the SQLite volume
RUN groupadd -g 1001 appuser && \
    useradd -u 1001 -g appuser -m -s /bin/bash appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app

# Configuration (secrets are injected at runtime; production refuses to boot on defaults)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    UVICORN_WORKERS=1 \
    ENVIRONMENT=production \
    DATABASE_URL=sqlite:////app/data/kai_sanctuary.db

USER appuser

# No VOLUME instruction: Railway rejects it. Docker Compose mounts kai_data at /app/data instead,
# and production uses Neon Postgres via DATABASE_URL.

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD sh -c 'curl -fsS "http://localhost:${PORT:-8000}/api/v1/health" || exit 1'

# Railway injects PORT; behind its proxy, trust X-Forwarded-* so request.url reports https.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${UVICORN_WORKERS:-1} --proxy-headers --forwarded-allow-ips '*'"]
