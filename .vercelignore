# The FastAPI backend ships as a Vercel Python function (api/index.py imports backend/).
# Root main.py is only the local uvicorn runner; leaving it out also avoids FastAPI auto-detection.
main.py
__pycache__/
.pytest_cache/
backend/**/test_*.py
backend/**/run_*.py
backend/test_*.py
backend/conftest.py
backend/testing.py

# Local state and container tooling
*.db
*.db-shm
*.db-wal
scratch/
.claude/
Dockerfile.*
docker-compose.yml
.env
.env.*
